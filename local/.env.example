# Copy to local/.env for local runs (git-ignored). The local server also falls
# back to sensible defaults, so this file is optional.

APP_ENV=local
PORT=3000
AWS_REGION=eu-west-2

# Local Postgres from docker-compose.
DATABASE_URL=postgresql://app:app@localhost:5432/app

# Local Cognito emulator (the local server uses a stub authorizer, so this is
# only needed if you exercise the real hosted-UI / token flows).
COGNITO_ENDPOINT=http://localhost:9229

# --- Deployed environments set these instead of DATABASE_URL ---------------
# DB_HOST=<rds-proxy-endpoint>
# DB_NAME=app
# DB_USER=app
# DB_SSL=true
# DB_IAM_AUTH=true            # mint RDS Proxy IAM tokens
# DB_SECRET_ARN=arn:aws:secretsmanager:...:secret:todo-api/db
# IDEMPOTENCY_TABLE=todo-api-dev-idempotency
