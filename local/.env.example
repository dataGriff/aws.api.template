# Reference for the variables packages/api/src/config.ts reads. `task serve`
# does NOT load this file automatically (the local server sets sane defaults);
# to use it: `set -a; . local/.env; set +a; task serve` or a tool like direnv.

APP_ENV=local
PORT=3000
AWS_REGION=eu-west-2
LOG_LEVEL=INFO                  # DEBUG | INFO | WARN | ERROR

# Local Postgres from docker-compose.
DATABASE_URL=postgresql://app:app@localhost:5432/app

# Observability (Powertools) — set by Terraform in deployed envs.
POWERTOOLS_SERVICE_NAME=todo-api-local
POWERTOOLS_METRICS_NAMESPACE=app
SERVICE_VERSION=dev             # reported by GET /health

# --- Deployed environments set these instead of DATABASE_URL ---------------
# DB_HOST=<rds-proxy-endpoint>
# DB_PORT=5432
# DB_NAME=app
# DB_USER=app
# DB_SSL=true
# DB_CA_PATH=/var/task/rds-ca.pem   # only for legacy RDS CAs not in Node's trust store
# DB_IAM_AUTH=true            # mint RDS Proxy IAM tokens
# DB_SECRET_ARN=arn:aws:secretsmanager:...:secret:todo-api/db   # when DB_IAM_AUTH=false
# IDEMPOTENCY_TABLE=todo-api-dev-idempotency
