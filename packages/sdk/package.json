{
  "name": "@app/sdk",
  "version": "0.0.0",
  "description": "Generated TypeScript client for the Todo API",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/dataGriff/aws.api.template.git",
    "directory": "packages/sdk"
  },
  "publishConfig": {
    "access": "restricted"
  },
  "scripts": {
    "gen": "kubb generate --config kubb.config.ts",
    "build": "tsup src/index.ts --format esm,cjs --dts --clean"
  },
  "dependencies": {
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@kubb/cli": "^3.5.0",
    "@kubb/core": "^3.5.0",
    "@kubb/plugin-client": "^3.5.0",
    "@kubb/plugin-oas": "^3.5.0",
    "@kubb/plugin-ts": "^3.5.0",
    "@kubb/plugin-zod": "^3.5.0",
    "tsup": "^8.3.5"
  }
}
