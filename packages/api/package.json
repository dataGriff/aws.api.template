{
  "name": "@app/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node esbuild.mjs",
    "serve": "tsx watch ../../local/server.ts",
    "db:migrate": "node-pg-migrate up -m src/db/migrations --no-lock",
    "db:migrate:down": "node-pg-migrate down -m src/db/migrations --no-lock",
    "test:unit": "vitest run test/unit test/handler --reporter=default --reporter=junit --outputFile=test-results/vitest-unit.xml",
    "test:integration": "vitest run test/integration --reporter=default --reporter=junit --outputFile=test-results/vitest-integration.xml",
    "test:bdd": "mkdir -p test-results && NODE_OPTIONS=\"--import tsx\" cucumber-js",
    "test:contract": "tsx test/contract/run.ts",
    "import:worker": "tsx ../../local/import-worker.ts"
  },
  "dependencies": {
    "@app/contracts": "workspace:*",
    "@aws-lambda-powertools/idempotency": "^2.10.0",
    "@aws-lambda-powertools/logger": "^2.10.0",
    "@aws-lambda-powertools/metrics": "^2.10.0",
    "@aws-lambda-powertools/parameters": "^2.10.0",
    "@aws-lambda-powertools/tracer": "^2.10.0",
    "@aws-sdk/client-dynamodb": "^3.1136.0",
    "@aws-sdk/client-s3": "^3.1136.0",
    "@aws-sdk/client-secrets-manager": "^3.1136.0",
    "@aws-sdk/rds-signer": "^3.1136.0",
    "@aws-sdk/s3-presigned-post": "^3.1136.0",
    "@aws-sdk/util-dynamodb": "^3.996.9",
    "@middy/core": "^5.5.1",
    "@middy/http-header-normalizer": "^5.5.1",
    "csv-parse": "^7.0.2",
    "pg": "^8.13.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@app/sdk": "workspace:*",
    "@aws-sdk/client-sqs": "^3.1136.0",
    "@cucumber/cucumber": "^11.1.0",
    "@testcontainers/postgresql": "^10.13.2",
    "@types/aws-lambda": "^8.10.145",
    "@types/pg": "^8.11.10",
    "esbuild": "^0.24.0",
    "node-pg-migrate": "^7.7.1",
    "testcontainers": "^10.13.2",
    "tsx": "^4.19.2",
    "vitest": "^2.1.4",
    "yaml": "^2.6.0"
  }
}
