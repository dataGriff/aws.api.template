{
  "name": "aws-api-template",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Best-practice secure AWS API template (TypeScript · Lambda · Postgres · REST API · Cognito)",
  "packageManager": "pnpm@9.12.3",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "pnpm -r build",
    "test": "pnpm -r --if-present test:unit",
    "prepare": "lefthook install 2>/dev/null || echo 'lefthook not on PATH (run `mise install` then `task hooks:install`)'",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@aws-sdk/client-kms": "^3.1136.0",
    "@aws-sdk/client-s3": "^3.1136.0",
    "@aws-sdk/client-sqs": "^3.1136.0",
    "@commitlint/cli": "^19.5.0",
    "@commitlint/config-conventional": "^19.5.0",
    "@eslint/js": "^9.14.0",
    "@semantic-release/changelog": "^6.0.3",
    "@semantic-release/git": "^10.0.1",
    "@types/node": "^22.9.0",
    "@vitest/coverage-v8": "^2.1.4",
    "eslint": "^9.14.0",
    "eslint-plugin-security": "^3.0.1",
    "globals": "^15.12.0",
    "prettier": "^3.3.3",
    "semantic-release": "^24.2.0",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.13.0",
    "vitest": "^2.1.4",
    "yaml": "^2.6.0"
  }
}
